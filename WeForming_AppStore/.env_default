# ─────────────────────────────────────────────────────────────────────────────
# Configuration template. Copy this file to `.env` and fill in your values:
#     cp .env_default .env
# `.env` is git-ignored (never commit real secrets); this template is committed.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL the BROWSER uses to reach the backend API (rebuild the frontend after changing).
#   Local dev            : http://localhost:8000
#   Behind nginx + HTTPS : https://your-domain.example        (single origin; API is at /api under it)
VITE_API_URL=http://localhost:8000

# Allowed browser origin(s) for CORS = where the frontend is served from (comma-separated).
# Behind an nginx single-origin proxy the app is same-origin, so CORS isn't really exercised,
# but set it to the public origin anyway.
#   Local dev            : http://localhost:8080
#   Behind nginx + HTTPS : https://your-domain.example
CORS_ORIGINS=http://localhost:8080

# --- Keycloak (external identity provider) ---
# Used by the plain `docker compose up`. During the bundled pre-flight
# (docker-compose.prod-keycloak.yml) these are overridden to point at the bundled Keycloak.
# Base URL of your Keycloak, e.g. https://keycloak.example.com  (no trailing slash)
KEYCLOAK_SERVER_URL=
# Realm name, e.g. weforming
KEYCLOAK_REALM=
# Confidential client with "Direct access grants" enabled, e.g. weforming-app-store
KEYCLOAK_CLIENT_ID=
# Client secret for the confidential client above
KEYCLOAK_CLIENT_SECRET=

# --- Optional ---
# Client role that marks a developer (default "dev").
#KEYCLOAK_DEVELOPER_ROLE=dev
# Public base URL of the store; if set, a confirm_url is included in install payloads.
#PUBLIC_BASE_URL=https://your-domain.example
# Postgres credentials (default to "weforming" if unset).
#POSTGRES_USER=weforming
#POSTGRES_PASSWORD=weforming
#POSTGRES_DB=weforming
